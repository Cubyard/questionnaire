{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "questionnaire",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "questionnaire",
      "database_id": "007b4fbc-fac1-4f60-ab67-74cd3c431e3f",
      "migrations_dir": "migrations"
    }
  ],
  // 10 submissions per minute per IP address.
  "ratelimits": [
    { "name": "SUBMIT_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }
  ],
  // Public Turnstile site key; the matching TURNSTILE_SECRET is a Worker secret.
  "vars": { "TURNSTILE_SITE_KEY": "0x4AAAAAAFXDI_5dobTuojF_" },
  "observability": { "enabled": true }
}
