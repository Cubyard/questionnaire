{
  "name": "questionnaire",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Quick, clean polls and questionnaires on Cloudflare Workers + D1.",
  "bin": { "qn": "./bin/qn.mjs" },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply questionnaire --local",
    "db:migrate:remote": "wrangler d1 migrations apply questionnaire --remote",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261014.1",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.150.0"
  }
}
